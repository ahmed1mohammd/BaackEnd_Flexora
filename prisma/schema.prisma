generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model Gym {
  id        String   @id @default(uuid())
  name      String
  ownerName String
  email     String   @unique
  address         String?
  status          String    @default("pending") // pending, active, freeze, suspended
  subscriptionEnd DateTime? // When the SaaS subscription expires
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Quotas (Limits)
  maxReceptionists Int      @default(1)
  maxCoaches       Int      @default(4)

  users              User[]
  members            Member[]
  packages           Package[]
  financialLogs      FinancialLog[]
  maintenanceTickets MaintenanceTicket[]
  attendances        Attendance[]
  platformPayments   PlatformFinancialLog[]
  activityLogs       ActivityLog[]
}

model User {
  id          String   @id @default(uuid())
  gymId       String
  name        String
  email       String   @unique
  phoneNumber String?
  password    String
  role        String   // Platform-Owner, Gym-Owner, Receptionist, Coach
  baseSalary  Float?   @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)
  
  assignedMembers Member[]  @relation("CoachToMember")
  activityLogs    ActivityLog[]
}

model Member {
  id              String    @id @default(uuid())
  gymId           String
  name            String
  phoneNumber     String
  trainingType    String    // General, Private
  coachId         String?
  qrCode          String    @unique @default(uuid())
  status          String    @default("expired") // expired, active, frozen
  subscriptionEnd DateTime?
  activePackageId String?
  gender          String    @default("Male") // Male, Female
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  gym   Gym   @relation(fields: [gymId], references: [id], onDelete: Cascade)
  coach User? @relation("CoachToMember", fields: [coachId], references: [id])
  activePackage Package? @relation(fields: [activePackageId], references: [id])
  attendances Attendance[]
}

model Package {
  id             String   @id @default(uuid())
  gymId          String
  name           String
  durationInDays Int
  price          Float
  type           String   // Gym, PT
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)
  members Member[]
}



model FinancialLog {
  id          String   @id @default(uuid())
  gymId       String
  type        String   // income, expense
  category    String   // subscription, pt_coaching, salary, maintenance, utility, other
  amount      Float
  description String
  refId       String?
  createdAt   DateTime @default(now())

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)
}

model MaintenanceTicket {
  id          String   @id @default(uuid())
  gymId       String
  equipment   String
  issue       String
  cost        Float    @default(0)
  status      String   @default("open") // open, in_progress, resolved
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)
}

model Attendance {
  id          String   @id @default(uuid())
  gymId       String
  memberId    String
  checkInTime DateTime @default(now())

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model PlatformFinancialLog {
  id          String   @id @default(uuid())
  gymId       String
  amount      Float
  description String
  createdAt   DateTime @default(now())

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)
}

model SaasPlan {
  id             String   @id @default(uuid())
  planName       String
  durationInDays Int
  price          Float
  description    String?  @default("")
  features       String[] @default([])
  maxReceptionists Int    @default(1)
  maxCoaches       Int    @default(4)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Activity Log System (Audit Logs)
model ActivityLog {
  id          String   @id @default(uuid())
  gymId       String?  // Nullable because some actions are platform-level
  userId      String   // Who performed the action
  action      String   // e.g. "CREATE_PLAN", "ACTIVATE_GYM"
  details     String   // Human-readable details
  createdAt   DateTime @default(now())

  gym         Gym?     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// SAAS PLATFORM EXPENSES
// ==========================================
model PlatformExpense {
  id          String   @id @default(uuid())
  amount      Float
  category    String   // e.g., Hosting, Marketing, Salaries, Other
  description String
  createdAt   DateTime @default(now())
}

// ==========================================
// SAAS: PLATFORM SETTINGS MATRIX
// ==========================================
model PlatformSettings {
  id               String   @id @default("default")
  supportEmail     String   @default("support@flexora.com")
  supportPhone     String   @default("")
  
  // روابط وسائل التواصل الاجتماعي
  facebookUrl      String   @default("")
  whatsappUrl      String   @default("")
  instagramUrl     String   @default("")
  snapchatUrl      String   @default("")
  linkedinUrl      String   @default("")
  
  // أزرار التحكم في الظهور (On/Off Switch Matrix)
  showFacebook     Boolean  @default(true)
  showWhatsapp     Boolean  @default(true)
  showInstagram    Boolean  @default(true)
  showSnapchat     Boolean  @default(false)
  showLinkedin     Boolean  @default(false)
  
  // الملف الضريبي والقانوني المصري
  taxNumber        String   @default("")
  commercialRecord String   @default("")
  showLegalFooter  Boolean  @default(false)
  
  updatedAt        DateTime @updatedAt
}